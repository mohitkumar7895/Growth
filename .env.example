# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=growth

# Authentication & Security
JWT_SECRET=change-this-to-a-long-random-64-char-secret-in-production
SESSION_COOKIE_NAME=gr_admin_session
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Initial Super Admin Setup (used only by scripts/setup-db.ts)
ADMIN_SEED_NAME=Growth Realtech Super Admin
ADMIN_SEED_EMAIL=admin@growthrealtech.com
ADMIN_SEED_PASSWORD=ChangeMe@Growth2026!

# Optional: Cloudinary Media Storage (falls back to local /public/uploads if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: SMTP Email Notifications (forwards all enquiries & contact forms to growthrealtechnoida@gmail.com & care@growthrealtech.in)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Growth Realtech Website <care@growthrealtech.in>"

# Optional: SMS OTP Gateway (Fast2SMS for India or Twilio Global — uses instant test OTP fallback if omitted)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
